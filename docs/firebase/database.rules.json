          ".read": "auth != null && (root.child('arenaRooms/'+$room+'/meta/owner').val() == auth.uid || root.child('arenaRooms/'+$room+'/members/'+auth.uid).exists())",
          ".write": "auth != null && root.child('arenaRooms/'+$room+'/meta/owner').val() == auth.uid",
          ".validate": "newData.hasChildren(['tick','payload','updatedAt']) && newData.child('tick').isNumber() && newData.child('tick').val() >= 0 && newData.child('tick').val() <= 1000000000 && newData.child('payload').isString() && newData.child('payload').val().length <= 18000 && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now + 30000 && newData.child('updatedAt').val() >= now - 120000",
          "tick": {
            ".validate": true
          },
          "payload": {
            ".validate": true
          },
          "updatedAt": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      }
