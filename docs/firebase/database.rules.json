            },
            "facing": {
              ".validate": "newData.isString() && (newData.val() == 'N' || newData.val() == 'NE' || newData.val() == 'E' || newData.val() == 'SE' || newData.val() == 'S' || newData.val() == 'SW' || newData.val() == 'W' || newData.val() == 'NW')"
            },
            "$other": {
              ".validate": false
            }
          },
          "events": {
            "$slot": {
              ".validate": "($slot == 'e0' || $slot == 'e1' || $slot == 'e2' || $slot == 'e3' || $slot == 'e4' || $slot == 'e5' || $slot == 'e6' || $slot == 'e7' || $slot == 'e8' || $slot == 'e9' || $slot == 'e10' || $slot == 'e11' || $slot == 'e12' || $slot == 'e13' || $slot == 'e14' || $slot == 'e15') && newData.hasChildren(['index','x','y','dx','dy','radius','combo','kind','at','seq'])",
              "index": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1600"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "dx": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
              },
              "dy": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
              },
              "radius": {
                ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 22"
              },
              "combo": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
              },
              "kind": {
                ".validate": "newData.isString() && (newData.val() == 'cast' || newData.val() == 'dive' || newData.val() == 'land')"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 30000"
              },
              "$other": {
                ".validate": false
              },
              "seq": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000000"
              }
            }
          },
          "hits": {
            "$hit": {
              ".validate": "$hit.matches(/^e([0-9]|1[0-5])$/) && newData.hasChildren(['index','source','seq','id','at','x','y','damage'])",
              "index": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "source": {
                ".validate": "newData.isString() && newData.val().matches(/^P[a-f0-9]{24}$/)"
              },
              "seq": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "id": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 30000"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1600"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "damage": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 30"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "fieldCoop": {
      "$room": {
        "meta": {
          ".read": "auth != null && $room.matches(/^[A-HJ-NP-Z2-9]{8}$/)",
          ".write": "auth != null && $room.matches(/^[A-HJ-NP-Z2-9]{8}$/) && newData.exists() && newData.child('owner').val() == auth.uid && ((!data.exists()) || (newData.child('createdAt').val() == data.child('createdAt').val() && root.child('coopPlayers').child($room).child('players').child(newData.child('connection').val()).child('owner').val() == auth.uid && root.child('coopPlayers').child($room).child('players').child(newData.child('connection').val()).child('updatedAt').val() >= now - 15000 && (!root.child('coopPlayers').child($room).child('players').child(data.child('connection').val()).exists() || root.child('coopPlayers').child($room).child('players').child(data.child('connection').val()).child('updatedAt').val() < now - 15000)))",
          ".validate": "newData.hasChildren(['owner','connection','createdAt'])",
          "owner": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "connection": {
            ".validate": "newData.isString() && newData.val().matches(/^P[a-f0-9]{24}$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((data.exists() && newData.val() == data.val()) || (!data.exists() && newData.val() >= now - 120000 && newData.val() <= now + 30000))"
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".read": "auth != null && $room.matches(/^[A-HJ-NP-Z2-9]{8}$/)",
          ".write": "auth != null && $room.matches(/^[A-HJ-NP-Z2-9]{8}$/) && newData.exists() && root.child('fieldCoop').child($room).child('meta').child('owner').val() == auth.uid && newData.child('writer').val() == root.child('fieldCoop').child($room).child('meta').child('connection').val() && root.child('coopPlayers').child($room).child('players').child(newData.child('writer').val()).child('owner').val() == auth.uid && root.child('coopPlayers').child($room).child('players').child(newData.child('writer').val()).child('updatedAt').val() >= now - 15000",
          ".validate": "newData.hasChildren(['revision','payload','updatedAt','writer']) && (!data.exists() || newData.child('revision').val() > data.child('revision').val())",
          "revision": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
          },
          "payload": {
            ".validate": "newData.isString() && newData.val().length <= 30000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 30000"
          },
          "$other": {
            ".validate": false
          },
          "writer": {
            ".validate": "newData.isString() && newData.val().matches(/^P[a-f0-9]{24}$/)"
          }
        }
      }
    }
  }
}
