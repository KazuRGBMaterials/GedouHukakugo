{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "players": {
          ".read": "auth != null && $room.matches(/^[A-HJ-NP-Z2-9]{8}$/)",
          "$connection": {
            ".write": "auth != null && $room.matches(/^[A-HJ-NP-Z2-9]{8}$/) && ((!data.exists() && !newData.exists()) || (!data.exists() && newData.exists() && newData.child('owner').val() == auth.uid) || (data.child('owner').val() == auth.uid && (!newData.exists() || newData.child('owner').val() == auth.uid))) && (!data.exists() || !newData.exists() || now - data.child('updatedAt').val() >= 60)",
            ".validate": "newData.hasChildren(['owner','label','color','x','y','facing','moving','seq','updatedAt'])",
            "owner": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1600"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "facing": {
              ".validate": "newData.isString() && newData.val().matches(/^(N|NE|E|SE|S|SW|W|NW)$/)"
            },
            "moving": {
              ".validate": "newData.isBoolean()"
            },
            "seq": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() >= now - 120000 && newData.val() <= now + 20000"
            },
            "$extra": {
              ".validate": false
            }
          }
        }
      }
    },
    "cloudSaves": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$slot": {
          ".write": "auth != null && auth.uid == $uid && ($slot == 'field-main' || $slot == 'field-preview' || $slot == 'editor-map' || $slot == 'battle-setup')",
          ".validate": "newData.hasChildren(['schemaVersion','slotId','revision','deviceId','updatedAt','payload']) && newData.child('schemaVersion').val() == 1 && newData.child('slotId').val() == $slot && newData.child('revision').isNumber() && ((!data.exists() && newData.child('revision').val() == 1) || (data.exists() && newData.child('revision').val() == data.child('revision').val() + 1)) && newData.child('deviceId').isString() && newData.child('deviceId').val().matches(/^[a-f0-9]{32}$/) && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now + 30000 && newData.child('updatedAt').val() >= now - 120000 && newData.child('payload').isString() && newData.child('payload').val().length <= 200000",
          "schemaVersion": {
            ".validate": true
          },
          "slotId": {
            ".validate": true
          },
          "revision": {
            ".validate": true
          },
          "deviceId": {
            ".validate": true
          },
          "updatedAt": {
            ".validate": true
          },
          "payload": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
