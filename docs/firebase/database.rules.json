          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('arenaRooms/'+$room+'/meta').exists()",
            ".validate": "newData.hasChildren(['label','joinedAt']) && newData.child('label').isString() && newData.child('label').val().length >= 1 && newData.child('label').val().length <= 16 && newData.child('joinedAt').isNumber() && newData.child('joinedAt').val() <= now + 30000 && newData.child('joinedAt').val() >= now - 120000",
